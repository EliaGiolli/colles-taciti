{
  "name": "colles-taciti",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && vue-tsc --noEmit -p tsconfig.vue.json",
    "lint": "biome check . && prettier --check \"**/*.{astro,vue}\" --no-error-on-unmatched-pattern && depcruise src tests",
    "format": "biome check --write . && prettier --write \"**/*.{astro,vue}\" --no-error-on-unmatched-pattern",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "astro build && playwright test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:integration",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.14",
    "@astrojs/vue": "7.0.3",
    "astro": "7.3.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/vue": "8.1.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "dependency-cruiser": "18.6.0",
    "jsdom": "30.1.2",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
