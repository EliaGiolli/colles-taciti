---
/**
 * /design-system: the shared components and type scale, in both themes.
 *
 * A working page for visual checks (compare with the DS artifact previews)
 * and for the e2e accessibility test, which runs axe on it in Notte and
 * Nebbia: if a token pair ever drops below the required contrast, CI fails.
 * Add each new shared component here as it is built.
 *
 * The theme is switched with the real toggle in the header (since PR 2):
 * the choice is saved like on any other page. The e2e test seeds the saved
 * choice instead of clicking, so each theme is checked from first paint.
 *
 * Not in production (Elia's decision, 2026-10-17): it is not a file in
 * src/pages, but a route added by an integration in astro.config.ts only
 * with `astro dev` and in the e2e build. `noindex` stays, in case a
 * preview of the e2e build is ever shared.
 */
import BaseLayout from "@/core/layout/components/BaseLayout.astro";
import BookItem from "@/features/books/components/BookItem.vue";
import BookShelf from "@/features/books/components/BookShelf.astro";
import Brand from "@/core/layout/components/Brand.astro";
import Cover from "@/features/covers/components/Cover.astro";
import { coversCopy } from "@/features/covers";
import ChapterIndex from "@/features/stories/components/ChapterIndex.astro";
import FearNote from "@/features/stories/components/FearNote.astro";
import OngoingBanner from "@/features/stories/components/OngoingBanner.astro";
import Prose from "@/features/stories/components/Prose.astro";
import ReadingControls from "@/features/stories/components/ReadingControls.astro";
import ContinueReading from "@/features/stories/reading-progress/components/ContinueReading.astro";
import ResumeLine from "@/features/stories/reading-progress/components/ResumeLine.astro";
import StoryCard from "@/features/stories/components/StoryCard.vue";
import StoryFacts from "@/features/stories/components/StoryFacts.astro";
import StoryHero from "@/features/stories/components/StoryHero.astro";
import { chaptersFromMarkdown } from "@/features/stories";
import { styleguideCopy as copy } from "@/features/styleguide/copy";
import Button from "@/shared/components/Button.astro";
import Field from "@/shared/components/Field.astro";
import Label from "@/shared/components/Label.astro";
import BaseFacetChip from "@/shared/vue/BaseFacetChip.vue";

const section = "flex flex-col gap-5 border-t border-linea pt-5";
const story = copy.story;
// Two sample chapters whose anchors match the headings of the sample prose.
const chapters = chaptersFromMarkdown(`## ${story.chapterTitle}\n\n## Capitolo 2`);
const heading = "font-display text-titolo-2";
---

<BaseLayout title={`${copy.title} · Colles Taciti`} description={copy.metaDescription} noindex>
  <div class="mx-auto flex max-w-pagina flex-col gap-7 px-4 py-8 md:px-6">
    <header class="flex flex-col gap-2">
      <Label tone="muted" as="p">
        Colles Taciti
      </Label>
      <h1 class="font-display text-titolo-1 md:text-display">{copy.title}</h1>
      <p class="max-w-misura text-osso-muto">{copy.intro}</p>
    </header>

    <section class={section} aria-labelledby="sg-marchio">
      <h2 id="sg-marchio" class={heading}>
        {copy.sections.brand}
      </h2>
      <Brand size="large" signature />
      <Brand />
    </section>

    <section class={section} aria-labelledby="sg-tipografia">
      <h2 id="sg-tipografia" class={heading}>
        {copy.sections.type}
      </h2>
      <p class="font-display text-display md:text-display-xl">{copy.type.display}</p>
      <p class="font-display text-titolo-1">{copy.type.titolo1}</p>
      <p class="font-display text-titolo-2">{copy.type.titolo2}</p>
      <p class="font-display text-titolo-corsivo italic">{copy.type.corsivo}</p>
      <p class="max-w-misura font-testo text-lettura">{copy.type.lettura}</p>
      <p class="max-w-misura text-corpo">{copy.type.corpo}</p>
      <p class="text-presentazione text-osso-muto italic">{copy.type.presentazione}</p>
      <p class="font-mono text-meta text-osso-muto">{copy.type.meta}</p>
    </section>

    <section class={section} aria-labelledby="sg-pulsanti">
      <h2 id="sg-pulsanti" class={heading}>
        {copy.sections.buttons}
      </h2>
      <div class="flex flex-wrap items-center gap-4">
        <Button variant="primary" href="#sg-pulsanti">
          {copy.buttons.primary}
        </Button>
        <Button href="#sg-pulsanti">{copy.buttons.secondary}</Button>
        <Button variant="link" href="#sg-pulsanti">
          {copy.buttons.link}
        </Button>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <Button variant="primary" disabled>
          {copy.buttons.disabled}
        </Button>
      </div>
      <div class="flex flex-wrap items-center gap-4 bg-carne p-5">
        <Label tone="onFlesh">{copy.labels.onFlesh}</Label>
        <Button variant="onFlesh" href="#sg-pulsanti">
          {copy.buttons.onFlesh}
        </Button>
      </div>
    </section>

    <section class={section} aria-labelledby="sg-etichette">
      <h2 id="sg-etichette" class={heading}>
        {copy.sections.labels}
      </h2>
      <div class="flex flex-wrap gap-5">
        <Label>{copy.labels.rust}</Label>
        <Label tone="muted">{copy.labels.muted}</Label>
      </div>
    </section>

    <section class={section} aria-labelledby="sg-filtri">
      <h2 id="sg-filtri" class={heading}>
        {copy.sections.filters}
      </h2>
      <div class="flex flex-col gap-2" role="group" aria-labelledby="sg-filtri-luogo">
        <Label tone="muted" as="p" id="sg-filtri-luogo">
          {copy.filters.group}
        </Label>
        <ul class="flex flex-wrap gap-2">
          {copy.filters.chips.map((chip) => (
            <li>
              <BaseFacetChip {...chip} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class={section} aria-labelledby="sg-modulo">
      <h2 id="sg-modulo" class={heading}>
        {copy.sections.form}
      </h2>
      <form class="flex max-w-misura flex-col gap-4" action="#sg-modulo">
        <p class="font-display text-titolo-corsivo italic">{copy.form.title}</p>
        <p class="text-osso-muto">{copy.form.lead}</p>
        <Field
          id="sg-testo"
          name="message"
          label={copy.form.messageLabel}
          placeholder={copy.form.messagePlaceholder}
          multiline
          required
        />
        <Field
          id="sg-testo-errore"
          name="message-error"
          label={copy.form.messageLabel}
          error={copy.form.messageError}
          multiline
        />
        <Field
          id="sg-mail"
          name="email"
          type="email"
          autocomplete="email"
          label={copy.form.emailLabel}
          note={copy.form.emailNote}
          help={copy.form.emailHelp}
        />
        <div>
          <Button variant="primary" type="submit">
            {copy.form.submit}
          </Button>
        </div>
      </form>
    </section>

    <section class={section} aria-labelledby="sg-copertine">
      <h2 id="sg-copertine" class={heading}>
        {copy.sections.covers}
      </h2>
      <ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-6">
        {copy.covers.map((cover) => (
          <li>
            <Cover {...cover} format="wattpad" />
          </li>
        ))}
      </ul>
    </section>

    <section class={section} aria-labelledby="sg-racconto">
      <h2 id="sg-racconto" class={heading}>
        {copy.sections.story}
      </h2>
      <StoryHero title={story.title} label={story.label} byline={story.byline}>
        <Cover
          slot="media"
          id="sg-banda"
          title={story.title}
          genre={story.label}
          motif="corridoio"
          format="banda"
          label={coversCopy.motifDescriptions.corridoio}
        />
      </StoryHero>
      <StoryFacts
        label={story.label}
        setting={story.setting}
        reading={story.reading}
        publishedAt={new Date("2026-10-12")}
        warnings={story.warnings}
        links={{ fears: story.fears, tags: story.tags }}
      />
      <ResumeLine preview={story.resume} />
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-y border-linea py-3 md:max-w-misura">
        <ChapterIndex chapters={chapters} />
        <ReadingControls />
      </div>
      <Prose>
        <h2 id="capitolo-1">
          <small>Capitolo 1</small> {story.chapterTitle}
        </h2>
        {story.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <hr />
        <p>{story.afterBreak}</p>
        <h2 id="capitolo-2">Capitolo 2</h2>
        <div class="ct-chat" role="log" aria-label="Chat della diretta">
          <div class="ct-chat__testa">
            <span class="ct-chat__diretta">In diretta</span>
            <span>1204 spettatori</span>
          </div>
          <ol>
            <li>
              <span class="ct-chat__ora">23:41</span>
              <span class="ct-chat__utente">dannyboi_88:</span>{" "}
              <span class="ct-chat__msg">ma è vero sangue?</span>
            </li>
            <li class="ct-chat__sistema">dannyboi_88 ha lasciato la chat</li>
            <li class="ct-chat__sistema ct-chat__sistema--grave">La diretta è stata interrotta.</li>
          </ol>
        </div>
        <pre
          class="ct-log"
          role="log"
          aria-label="Log del sistema"
        ><span>[06:12:04] INFO  legacy.boot(): avvio processo notturno</span><span>[06:12:09] WARN  luci: sensore non risponde</span><span class="ct-log__err ct-glitch">[06:12:11] ERR   body.handover(): corpo non trovato</span><span class="ct-log__err ct-glitch ct-glitch--vivo">[06:12:11] ERR   body.handover(): corpo non trovato</span></pre>
        <p>Il messaggio gli arrivò direttamente nei percorsi neurali.</p>
        <p class="ct-segnale">Error 404: friendship not found.</p>
        <p>
          <code>git merge SaraGiacomo?</code> chiese Sara attraverso il segnale.
        </p>
      </Prose>
      <OngoingBanner chapter={3} />
      <FearNote note={story.fearNote} />
      <ul class="grid gap-x-6 md:grid-cols-2">
        <li>
          <StoryCard story={story.card} />
        </li>
        <li>
          <StoryCard story={story.ongoingCard} />
        </li>
      </ul>
      <ContinueReading preview={{ href: "#sg-racconto", ...story.continueReading }} />
    </section>

    <section class={section} aria-labelledby="sg-libri">
      <h2 id="sg-libri" class={heading}>
        {copy.sections.books}
      </h2>
      <BookShelf books={[...copy.books, ...copy.books]} />
      <ul class="flex max-w-[40rem] flex-col">
        {copy.books.map((book) => (
          <li>
            <BookItem book={book} />
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
