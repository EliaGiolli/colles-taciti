---
/**
 * The content of a fear's page (/body-horror, /slasher…): the fear, its
 * stories, and the way to the other four. DS: no dedicated page template;
 * the heading follows the archive (/racconti), the stories are
 * SchedaRacconto with cover, the other fears are SceltaPaura.
 *
 * These five pages are the indexable lists of the site (PLAN › Ricerca ›
 * SEO: «indicizzabili solo le 5 categorie»), so everything on them is
 * static HTML: no island, no Vue in the browser. The story cards are Vue
 * components rendered on the server, as on the homepage. Readers who want
 * to narrow further follow «Tutti i racconti» to the archive.
 *
 * The definition is the fear's own sentence («Quando il corpo smette di
 * essere tuo.»), set as the page's tagline in Bodoni italic. Under it, when
 * the fear has them (all but Esperimenti, which is not a subgenre), one
 * paragraph on the subgenre and the link to its video on The Horror
 * Scriptorium. That link is a plain one, without `rel="nofollow"`: it is a
 * tribute to the channel, and a backlink only counts if search engines may
 * follow it. Same tab, as for every external link (DS). The video's title
 * is English, so it is marked `lang="en"` for screen readers' pronunciation,
 * and the lead-in says the video is in English before anyone clicks.
 *
 * An empty fear (Esperimenti, at launch) says so with the PLAN's empty
 * state instead of a count of zero.
 *
 * @example <CategoryPage fear={fear} stories={cards} others={otherFears} />
 */
import {
  STORIES_PATH,
  StoryCard,
  type StoryCardData,
  storiesCopy,
} from "@/features/stories/client";
import type { FearWithCount } from "@/features/stories";
import Button from "@/shared/components/Button.astro";
import Label from "@/shared/components/Label.astro";
import { categoriesCopy as copy } from "./copy";
import FearPicker from "./FearPicker.astro";

export interface Props {
  fear: FearWithCount;
  /** The fear's stories as cards, newest first. */
  stories: readonly StoryCardData[];
  /** The other fears, for «Le altre paure». */
  others: readonly FearWithCount[];
}

const { fear, stories, others } = Astro.props;
const othersId = "le-altre-paure";
---

<div class="mx-auto flex max-w-pagina flex-col gap-8 px-4 py-7 md:gap-9 md:px-6 md:py-8">
  <div class="flex flex-col gap-6">
    <header class="flex flex-col gap-4">
      <Label tone="muted" as="p">
        {copy.page.eyebrow}
      </Label>
      <h1 class="font-display text-titolo-1 md:text-display">{fear.name}</h1>
      <p class="max-w-misura font-display text-titolo-corsivo text-osso-muto italic">
        {fear.definition}
      </p>
      {fear.intro && <p class="max-w-misura text-corpo">{fear.intro}</p>}
      {fear.watch && (
        <p class="flex flex-col items-start gap-1">
          <span class="font-mono text-meta text-osso-muto">{copy.page.watchLead}</span>
          <Button variant="link" href={fear.watch.url}>
            <span lang="en">{fear.watch.title}</span> {copy.page.watchChannel}
          </Button>
        </p>
      )}
      {stories.length > 0 && (
        <p class="font-mono text-meta text-osso-muto">{copy.count(fear.count)}</p>
      )}
    </header>

    {stories.length > 0 ? (
      <ul class="flex max-w-[40rem] flex-col">
        {stories.map((story) => (
          <li>
            <StoryCard story={story} headingLevel={2} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-corpo">{storiesCopy.empty}</p>
    )}

    <p>
      <Button variant="link" href={STORIES_PATH}>
        {copy.page.all}
      </Button>
    </p>
  </div>

  {others.length > 0 && (
    <section aria-labelledby={othersId} class="flex flex-col gap-5">
      <h2 id={othersId} class="font-display text-titolo-1">
        {copy.page.others}
      </h2>
      <FearPicker fears={others} />
    </section>
  )}
</div>
