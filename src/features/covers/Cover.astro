---
/**
 * A story cover drawn inline as SVG. DS: Copertina (`.ct-copertina`).
 *
 * The SVG comes from `coverSvg()` (cover.ts). Inline rather than as an
 * `<img>`: its paint classes read the theme tokens (app.css › Copertina),
 * so the same cover follows Notte and Nebbia, costs no request and stays
 * sharp at any size. The PNG versions (`bun run copertine`) exist for the
 * places that need a file: Wattpad, Instagram, link previews.
 *
 * `set:html` inserts the string as markup. It is safe here because every
 * piece of text inside it goes through `escapeXml()` first.
 *
 * @example <Cover id="senza-rimorso" title="Senza Rimorso" genre="Slasher · in corso" motif="diario" format="wattpad" />
 */
import { type CoverInput, coverSvg } from "./cover";

export type Props = CoverInput;

const svg = coverSvg(Astro.props);
---

<Fragment set:html={svg} />
