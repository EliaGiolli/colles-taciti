---
/**
 * «Perché "Colles Taciti"»: what the name means, in Elia's voice. The only
 * words about the author on the site, since there is no «Chi sono» page
 * (PLAN › Pagine). DS: no dedicated component; heading and body text in the
 * reading measure, as in the mockup.
 *
 * «Silentes» is in italic: a Latin word (DS › Prosa). The space between the
 * word and the rest is part of the copy string, so Astro cannot drop it.
 *
 * @example <WhyCollesTaciti />
 */
import { homeCopy as copy } from "../copy";
import HomeSection from "./HomeSection.astro";
---

<HomeSection id="perche" title={copy.why.title}>
  <p class="max-w-misura text-corpo">
    <em>{copy.why.latinWord}</em>
    {copy.why.text}
  </p>
</HomeSection>
