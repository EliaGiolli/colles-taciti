---
/**
 * «La paura dietro il racconto», the personal note at the end of every
 * story: the one text that exists only on the site. DS: NotaPaura
 * (`.ct-paura`).
 *
 * The only block on `terra-alta`: «deve sembrare un foglio a parte, intimo,
 * non un box promozionale» (DS). Label, an H2 in Bodoni italic, 80–150
 * words in paragraphs (the schema checks the count), the signature «— Elia».
 *
 * The note is written in the frontmatter as plain text, paragraphs
 * separated by a blank line, and split here.
 *
 * A `<section>` named by its heading rather than the DS's `<aside>`: the
 * note sits inside `<main>`, and an aside there would be a complementary
 * landmark nested in another landmark, which assistive technologies handle
 * poorly. A named section is a region of the main content, which it is.
 *
 * `data-fear-note` is watched by the reading-progress controller: when the
 * note comes into view, the story counts as finished.
 *
 * @example <FearNote note={story.data.fearNote} />
 */
import Label from "@/shared/components/Label.astro";
import { storiesCopy as copy } from "../copy";

export interface Props {
  /** The note, paragraphs separated by a blank line. */
  note: string;
}

const paragraphs = Astro.props.note
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.replace(/\s+/g, " ").trim())
  .filter((paragraph) => paragraph !== "");
const headingId = "la-paura";
---

<section
  data-fear-note
  aria-labelledby={headingId}
  class="flex max-w-misura flex-col bg-terra-alta px-5 py-6"
>
  <Label tone="muted" as="p">
    {copy.fearNote.eyebrow}
  </Label>
  <h2 id={headingId} class="mt-2 mb-4 font-display text-titolo-corsivo italic">
    {copy.fearNote.title}
  </h2>
  {paragraphs.map((paragraph) => (
    <p class="mb-4 text-corpo">{paragraph}</p>
  ))}
  <p class="font-mono text-meta text-osso-muto">{copy.fearNote.signature}</p>
</section>
