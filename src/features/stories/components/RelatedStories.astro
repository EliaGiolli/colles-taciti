---
/**
 * «Se ti è piaciuto»: the two related stories at the end of a story page
 * (SEO brief › §7, mockup › story page). Internal links that keep a reader
 * on the site, and help search engines find the other stories.
 *
 * Two columns from 768px, as in the mockup; one on phones. The cards are
 * `StoryCard.vue` rendered on the server: no JavaScript reaches the page
 * (no `client:` directive), so story pages stay free of Vue.
 *
 * Nothing is rendered when a story has no related stories.
 *
 * @example <RelatedStories stories={related.map(storyCard)} />
 */
import type { StoryCardData } from "../helpers/card";
import { storiesCopy as copy } from "../copy";
import StoryCard from "./StoryCard.vue";

export interface Props {
  stories: readonly StoryCardData[];
}

const { stories } = Astro.props;
const headingId = "se-ti-e-piaciuto";
---

{stories.length > 0 && (
  <section aria-labelledby={headingId} class="flex flex-col gap-5">
    <h2 id={headingId} class="font-display text-titolo-1">
      {copy.related.title}
    </h2>
    <ul class="grid gap-x-6 md:grid-cols-2">
      {stories.map((story) => (
        <li>
          <StoryCard story={story} />
        </li>
      ))}
    </ul>
  </section>
)}
