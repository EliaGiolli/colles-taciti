---
/**
 * The opening of a story page. DS: Hero / racconto (`.ct-hero--racconto`).
 *
 * A full-width 5:2 band with the story's cover motif, and a «cartiglio»
 * (sub-genre, H1, byline) that cuts into it from below on a solid terra
 * background. The text never sits on the image, so its contrast holds
 * whatever the image is (DS › Hero).
 *
 * The image goes in the `media` slot: the page passes `<Cover format="banda">`.
 * A slot rather than an import keeps this feature from depending on the
 * covers feature's components (pages wire features together).
 *
 * The cartiglio rises 72px (`-mt-8`) into the band and keeps a 24px gap on
 * its left (`ml-5`), as in the DS. On a 375px phone the band is 150px tall,
 * well under the DS limit of 70% of the screen: the title shows without
 * scrolling.
 *
 * Title size: `titolo-1` on phones, `display` from 768px (DS › Tipografia).
 *
 * @example
 * <StoryHero title="Le vibrazioni" label="Horror psicologico" byline="di Elia Giolli · 9 min">
 *   <Cover slot="media" … format="banda" />
 * </StoryHero>
 */
import Label from "@/shared/components/Label.astro";
import { storiesCopy as copy } from "./copy";

export interface Props {
  title: string;
  /** Sub-genre («Horror liminale»). */
  label: string;
  /** Adds «in corso» to the label, in ferita (DS › SchedaRacconto). */
  ongoing?: boolean;
  /** «di Elia Giolli · 5 capitoli · 38 min». */
  byline: string;
}

const { title, label, ongoing = false, byline } = Astro.props;
---

<section>
  <div class="ct-grana relative aspect-banda overflow-hidden [&>svg]:absolute [&>svg]:inset-0 [&>svg]:h-full">
    <slot name="media" />
  </div>
  <div class="relative -mt-8 ml-5 flex max-w-[36rem] flex-col gap-3 bg-terra pt-5 pr-5">
    <Label>
      {label}
      {ongoing && (
        <>
          {" · "}
          <span class="text-ferita">{copy.ongoing}</span>
        </>
      )}
    </Label>
    <h1 class="font-display text-titolo-1 md:text-display">{title}</h1>
    <p class="font-mono text-meta text-osso-muto">{byline}</p>
  </div>
</section>
