---
/**
 * Small uppercase mono label. DS: Etichetta (`.ct-etichetta`).
 * Classes from `shared/variants/label.ts`.
 *
 * Used for sub-genres («Body horror»), section names and states. Write the
 * text in normal case: CSS turns it uppercase, and screen readers still read
 * it as words. Not an HTML `<label>`: form labels are part of `Field`.
 *
 * @example <Label>Body horror</Label>
 * @example <Label tone="muted" as="p">Ultimi racconti</Label>
 */
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/shared/helpers/cn";
import { type LabelTone, labelVariants } from "@/shared/variants/label";

export interface Props extends Omit<HTMLAttributes<"span">, "class"> {
  /** Colour: `rust` (default, sub-genres), `muted` (sections), `onFlesh` (on carne). */
  tone?: LabelTone;
  /** Element to render: inline `span` (default) or a block `p`. */
  as?: "span" | "p";
  /** Extra classes, merged with `cn()`. */
  class?: string;
}

const { tone = "rust", as: Element = "span", class: className, ...attributes } = Astro.props;
---

<Element class={cn(labelVariants({ tone }), className)} {...attributes}>
  <slot />
</Element>
