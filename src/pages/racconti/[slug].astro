---
/**
 * /racconti/<slug>: one story, on a single page with a chapter index
 * (PLAN › Racconti a capitoli, Pagine › 3).
 *
 * Order, from the PLAN and the mockup: Hero (cover band, sub-genre, title,
 * byline) · SchedaTecnica · ResumeLine · chapter index and reading controls
 * · Prosa · InCorso (ongoing stories) · NotaPaura · feedback form ·
 * «Se ti è piaciuto» · Wattpad link.
 *
 * Every story is prerendered at build time: `getStaticPaths` lists them,
 * and the integrity check of `getStories()` runs first, so a broken
 * reference stops the build instead of publishing a broken page.
 *
 * JavaScript on this page: only the controllers it names (theme switch,
 * reading controls, reading progress, feedback form), loaded lazily by the registry. No
 * Vue: the story cards are Vue components rendered to HTML on the server.
 *
 * Title and description come from the SEO brief through the frontmatter;
 * the link preview is the story's 1200×630 cover, and the JSON-LD a
 * `ShortStory` (core/seo).
 */
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/core/layout/components/BaseLayout.astro";
import { shortStoryJsonLd } from "@/core/seo/helpers/jsonld";
import Cover from "@/features/covers/components/Cover.astro";
import FeedbackForm from "@/features/feedback/components/FeedbackForm.astro";
import { coversCopy } from "@/features/covers";
import ChapterIndex from "@/features/stories/components/ChapterIndex.astro";
import FearNote from "@/features/stories/components/FearNote.astro";
import OngoingBanner from "@/features/stories/components/OngoingBanner.astro";
import Prose from "@/features/stories/components/Prose.astro";
import ReadingControls from "@/features/stories/components/ReadingControls.astro";
import RelatedStories from "@/features/stories/components/RelatedStories.astro";
import ResumeLine from "@/features/stories/reading-progress/components/ResumeLine.astro";
import StoryFacts from "@/features/stories/components/StoryFacts.astro";
import StoryHero from "@/features/stories/components/StoryHero.astro";
import {
  getRelatedStories,
  getStories,
  getStoryCover,
  coverImageHref,
  getStoryLinks,
  type Story,
  storiesCopy as copy,
  storyCard,
  storyReadingSummary,
} from "@/features/stories";
import Button from "@/shared/components/Button.astro";

export const getStaticPaths = (async () => {
  const stories = await getStories();
  return stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}) satisfies GetStaticPaths;

interface Props {
  story: Story;
}

const { story } = Astro.props;
const { data } = story;
const { Content } = await render(story.entry);
const [cover, links, related] = await Promise.all([
  getStoryCover(story, "banda"),
  getStoryLinks(story),
  getRelatedStories(story),
]);
const reading = storyReadingSummary(story);
const site = (Astro.site ?? Astro.url).origin;
const image = coverImageHref(story.id);
const jsonLd = shortStoryJsonLd(site, {
  url: new URL(story.href, site).href,
  title: data.title,
  description: data.seo.description,
  genre: data.label,
  image: new URL(image, site).href,
  datePublished: data.publishedAt,
  dateModified: data.updatedAt,
  ongoing: data.status === "ongoing",
  series: data.series,
});
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  image={image}
  type="article"
  jsonLd={[jsonLd]}
>
  <div class="mx-auto flex max-w-pagina flex-col gap-7 px-4 py-6 md:px-6 md:py-7">
    <StoryHero
      title={data.title}
      label={data.label}
      ongoing={data.status === "ongoing"}
      byline={`${copy.byline} · ${reading}`}
    >
      <Cover slot="media" {...cover} label={coversCopy.motifDescriptions[cover.motif]} />
    </StoryHero>

    <StoryFacts
      label={data.label}
      setting={data.setting}
      reading={reading}
      publishedAt={data.publishedAt}
      updatedAt={data.updatedAt}
      warnings={data.warnings}
      links={links}
    />

    <div
      data-controller="reading-progress"
      data-story-id={story.id}
      data-story-title={data.title}
      data-story-href={story.href}
      class="flex flex-col gap-6"
    >
      <ResumeLine />
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-y border-linea py-3 md:max-w-misura">
        <ChapterIndex chapters={story.chapters} />
        <ReadingControls />
      </div>
      <Prose>
        <Content />
      </Prose>
      {data.status === "ongoing" && data.chapterReached !== undefined && (
        <OngoingBanner chapter={data.chapterReached} />
      )}
      <FearNote note={data.fearNote} />
    </div>

    <FeedbackForm story={story.id} />

    <RelatedStories stories={related.map((story) => storyCard(story))} />

    {data.wattpadUrl && (
      <p>
        <Button
          variant="link"
          href={data.wattpadUrl}
          data-track="wattpad_click"
          data-track-story={story.id}
        >
          {copy.wattpad}
        </Button>
      </p>
    )}
  </div>
</BaseLayout>
