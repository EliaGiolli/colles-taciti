---
/**
 * /<fear>: one page per fear, five in all (/body-horror,
 * /horror-psicologico, /slasher, /liminale, /esperimenti; PLAN › Pagine ›
 * 4). `getStaticPaths` lists them from the `fears` collection, so adding a
 * fear to fears.json adds its page.
 *
 * A dynamic segment at the root of the site is safe here: Astro gives
 * static routes (/racconti, /design-system…) priority over `[categoria]`,
 * and only the five fear ids are ever generated, so any other address is
 * still a 404.
 *
 * Title and description come from fears.json (`seo`); the JSON-LD is a
 * `CollectionPage` listing the stories, the preview image the newest one's cover.
 */
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/core/layout/components/BaseLayout.astro";
import { collectionPageJsonLd } from "@/core/seo/helpers/jsonld";
import CategoryPage from "@/features/categories/components/CategoryPage.astro";
import {
  coverImageHref,
  type FearWithCount,
  getFearsWithCounts,
  getStoriesByFear,
  getStoryThumbnail,
  storyCard,
} from "@/features/stories";

export const getStaticPaths = (async () => {
  const fears = await getFearsWithCounts();
  return fears.map((fear) => ({
    params: { categoria: fear.id },
    props: { fear, others: fears.filter((other) => other.id !== fear.id) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  fear: FearWithCount;
  others: FearWithCount[];
}

const { fear, others } = Astro.props;
const fearStories = await getStoriesByFear(fear.id);
const site = (Astro.site ?? Astro.url).origin;
const jsonLd = collectionPageJsonLd(
  { url: new URL(fear.href, site).href, name: fear.name, description: fear.seo.description },
  fearStories.map((story) => ({ url: new URL(story.href, site).href, title: story.data.title })),
);
const image = fearStories[0] ? coverImageHref(fearStories[0].id) : undefined;
const stories = await Promise.all(
  fearStories.map(async (story) =>
    storyCard(story, { withSetting: true, cover: await getStoryThumbnail(story) }),
  ),
);
---

<BaseLayout
  title={fear.seo.title}
  description={fear.seo.description}
  image={image}
  jsonLd={[jsonLd]}
>
  <CategoryPage fear={fear} stories={stories} others={others} />
</BaseLayout>
