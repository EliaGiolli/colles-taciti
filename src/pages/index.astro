---
/**
 * Home page: temporary placeholder from PR 0 (`chore/bootstrap`), inside the
 * real site frame since PR 2. The real homepage arrives in PR 7.
 *
 * It proves the toolchain end to end (build, preview, the controller
 * registry, unit/integration/e2e tests, accessibility checks) before any
 * real feature is written.
 */
import BaseLayout from "@/core/layout/BaseLayout.astro";
import { homeCopy } from "@/features/home/copy";
---

<BaseLayout title={homeCopy.siteName} description={homeCopy.metaDescription}>
  <div class="mx-auto flex max-w-pagina flex-col gap-4 px-4 py-8 md:px-6 md:py-9">
    <h1 class="font-display text-display md:text-display-xl">{homeCopy.siteName}</h1>
    <!-- One expression: Astro drops the line break between two expressions,
         which would glue the sentences together («italiano.Il sito»). -->
    <p class="font-display text-titolo-corsivo text-osso-muto italic">
      {`${homeCopy.tagline} ${homeCopy.underConstruction}`}
    </p>
  </div>
</BaseLayout>
