---
/**
 * The homepage (PLAN › Pagine › 1, SEO brief v2 › §6, mockup page 1).
 *
 * Order: Hero · «Stai leggendo» (only for a reader with a story left
 * half-way) · introduction · «Da dove cominciare» · «Ultimi racconti» ·
 * InCorso · «Scegli la tua paura» · «Perché Colles Taciti» · feedback form.
 *
 * Its job is to convert, not to rank (SEO brief › §1: traffic arrives on the
 * story pages): get a second story read, get feedback written. Hence the one
 * primary button, «Inizia a leggere», leads straight to the first story of
 * «Da dove cominciare», the one Elia picked for newcomers, rather than to
 * another list.
 *
 * Sections are 72px apart on phones and 112px on desktop (DS › Spazio:
 * «il vuoto è parte del racconto»). The page ships no Vue: the cards are Vue
 * components rendered to HTML on the server. Its only scripts are the theme
 * switch, «Stai leggendo» and the feedback form.
 */
import BaseLayout from "@/core/layout/BaseLayout.astro";
import heroPhoto from "../assets/foto/abat-jour-notte.jpg";
import { websiteJsonLd } from "@/core/seo/jsonld";
import FearPicker from "@/features/categories/FearPicker.astro";
import { categoriesCopy } from "@/features/categories/copy";
import { Picture } from "astro:assets";
import FeedbackForm from "@/features/feedback/FeedbackForm.astro";
import { homeCopy as copy } from "@/features/home/copy";
import HomeHero from "@/features/home/HomeHero.astro";
import HomeSection from "@/features/home/HomeSection.astro";
import WhyCollesTaciti from "@/features/home/WhyCollesTaciti.astro";
import {
  coverImageHref,
  getFearsWithCounts,
  getLatestStories,
  getOngoingStories,
  getStarters,
  getStoryThumbnail,
  STORIES_PATH,
  storiesCopy,
  storyCard,
} from "@/features/stories";
import OngoingBanner from "@/features/stories/OngoingBanner.astro";
import ContinueReading from "@/features/stories/reading-progress/ContinueReading.astro";
import StoryCard from "@/features/stories/StoryCard.vue";

/** Three cards per row from 1024px (DS › Spazio: grids only from 1024px). */
const LATEST_COUNT = 3;

const [starters, latest, ongoing, fears] = await Promise.all([
  getStarters(),
  getLatestStories(LATEST_COUNT),
  getOngoingStories(),
  getFearsWithCounts(),
]);

// «Da dove cominciare»: the hook in the label place, no metadata (mockup).
const starterCards = starters.map((story) => ({
  ...storyCard(story),
  label: story.data.starter?.hook ?? story.data.label,
  meta: undefined,
}));
const latestCards = await Promise.all(
  latest.map(async (story) =>
    storyCard(story, { withSetting: true, cover: await getStoryThumbnail(story) }),
  ),
);
// One InCorso banner per page at most (DS › InCorso): the newest ongoing story.
const [current] = ongoing;
const firstStory = starters[0]?.href ?? latest[0]?.href ?? STORIES_PATH;
const grid = "grid gap-x-6 lg:grid-cols-3";
// Link preview: the cover of the story picked for newcomers.
const image = starters[0] ? coverImageHref(starters[0].id) : undefined;
const jsonLd = websiteJsonLd((Astro.site ?? Astro.url).origin, copy.siteName, copy.metaDescription);
---

<BaseLayout title={copy.title} description={copy.metaDescription} image={image} jsonLd={jsonLd}>
  <div class="mx-auto flex max-w-pagina flex-col gap-8 px-4 py-7 md:gap-9 md:px-6 md:py-8">
    <HomeHero href={firstStory}>
      <Picture
        slot="media"
        src={heroPhoto}
        alt={copy.hero.photoAlt}
        formats={["avif", "webp"]}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 768px) 58vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-[50%_64%]"
      />
    </HomeHero>

    <ContinueReading />

    <p class="max-w-misura text-corpo">{copy.intro}</p>

    {starterCards.length > 0 && (
      <HomeSection id="da-dove-cominciare" title={copy.starters.title}>
        <ul class={grid}>
          {starterCards.map((story) => (
            <li>
              <StoryCard story={story} />
            </li>
          ))}
        </ul>
      </HomeSection>
    )}

    {latestCards.length > 0 && (
      <HomeSection
        id="ultimi-racconti"
        title={copy.latest.title}
        action={{ href: STORIES_PATH, label: copy.latest.all }}
      >
        <ul class={grid}>
          {latestCards.map((story) => (
            <li>
              <StoryCard story={story} />
            </li>
          ))}
        </ul>
      </HomeSection>
    )}

    {current && current.data.chapterReached !== undefined && (
      <OngoingBanner
        chapter={current.data.chapterReached}
        title={current.data.title}
        text={`${current.data.logline} ${storiesCopy.ongoingBanner.text}`}
        href={current.href}
        action={copy.ongoing.action}
      />
    )}

    <HomeSection id="scegli-la-tua-paura" title={categoriesCopy.picker.title}>
      <FearPicker fears={fears} />
    </HomeSection>

    <WhyCollesTaciti />

    <FeedbackForm />
  </div>
</BaseLayout>
