---
/**
 * The site footer: tagline, full navigation and signature.
 * DS: Navigazione / piede (bundle.css › .ct-piede).
 *
 * Links (PLAN › Pagine › Piede): Racconti · Libri · Portfolio · Instagram ·
 * Wattpad · Preferenze cookie. Two are not here yet: Instagram, until the
 * profile exists (see nav.ts), and «Preferenze cookie», which reopens the
 * consent banner and so arrives with it in PR 9. External profiles open
 * in the same tab (DS › Navigazione): a new tab is the reader's choice.
 *
 * The motto follows the DS preview exactly (Bodoni italic, 20px, osso-muto),
 * although 20px sits below the DS's «Bodoni never under 24px» rule: the
 * component spec is the more specific of the two. Its weight is the theme's
 * italic-title weight (400 in Notte, 500 in Nebbia), like the DS.
 *
 * The year is the build year in Rome (see `formatYear`).
 */
import { formatYear } from "@/shared/lib/format-date";
import { layoutCopy as copy } from "./copy";
import { EXTERNAL_LINKS, isCurrentPath, NAV_LINK_CLASSES, ROUTES } from "./nav";

const links = [
  { href: ROUTES.stories, label: copy.nav.stories },
  { href: ROUTES.books, label: copy.nav.books },
  { href: EXTERNAL_LINKS.portfolio, label: copy.nav.portfolio },
  { href: EXTERNAL_LINKS.wattpad, label: copy.nav.wattpad },
];
const pathname = Astro.url.pathname;
const year = formatYear(new Date());
import { PUBLIC_GA_ID } from "astro:env/client";
import { consentCopy } from "@/core/consent/copy";
import { cn } from "@/shared/lib/cn";
---

<footer class="border-t border-linea">
  <div class="mx-auto flex max-w-pagina flex-col gap-4 px-4 py-6 md:px-6">
    <p class="font-display text-[1.25rem]/[1.3] font-(--peso-corsivo) text-osso-muto italic">
      {copy.motto}
    </p>
    <nav aria-label={copy.footerNavLabel}>
      <ul class="flex flex-wrap gap-x-5">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class={NAV_LINK_CLASSES}
              aria-current={isCurrentPath(pathname, href) ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    {PUBLIC_GA_ID && (
      <p class="no-js:hidden">
        <button type="button" data-consent-open class={cn(NAV_LINK_CLASSES, "cursor-pointer")}>
          {consentCopy.preferences}
        </button>
      </p>
    )}
    <p class="font-mono text-meta text-osso-muto">{`${copy.footerSignature} · ${year}`}</p>
  </div>
</footer>
