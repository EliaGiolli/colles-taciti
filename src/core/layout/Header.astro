---
/**
 * The site header: wordmark, main navigation and theme switch.
 * DS: Navigazione / testata (bundle.css › .ct-testata).
 *
 * Differences from the DS preview, both decided in docs/PLAN.md:
 * - the nav has Racconti and Libri only: there is no «Chi sono» page (the
 *   little there is about Elia lives on the homepage);
 * - the theme switch sits here, after the nav, separated by a rule.
 *
 * Not sticky (DS › Navigazione): whoever reads a story should have only
 * the text in front of them.
 *
 * Layout: one row on desktop (brand left, nav and switch right). At 375px
 * the row does not fit, so it wraps: brand on the first line, nav and
 * switch on the second. `flex-wrap` does that without a breakpoint.
 *
 * `view-transition-name: testata` makes the header its own layer in
 * cross-document View Transitions: identical on both pages, it stays still
 * while the content below cross-fades (see app.css).
 */
import ThemeToggle from "@/core/theme/ThemeToggle.astro";
import { layoutCopy as copy } from "./copy";
import Brand from "./Brand.astro";
import { isCurrentPath, NAV_LINK_CLASSES, ROUTES } from "./nav";

const links = [
  { href: ROUTES.stories, label: copy.nav.stories },
  { href: ROUTES.books, label: copy.nav.books },
];
const pathname = Astro.url.pathname;
---

<header class="border-b border-linea [view-transition-name:testata]">
  <div class="mx-auto flex max-w-pagina flex-wrap items-center justify-between gap-x-5 gap-y-2 px-4 py-4 md:px-6">
    <Brand />
    <div class="flex items-center gap-5">
      <nav aria-label={copy.mainNavLabel}>
        <ul class="flex gap-5">
          {links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class={NAV_LINK_CLASSES}
                aria-current={isCurrentPath(pathname, href) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle class="border-l border-linea pl-5" />
    </div>
  </div>
</header>
