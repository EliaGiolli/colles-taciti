# Environment variables for Colles Taciti.
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored:
# real secrets never enter the repository. Production values live in the
# Vercel project settings (changing them needs Elia's confirmation).
#
# The typed schema (astro:env) that validates these at build time arrives with
# the features that need them; none is required to run the site in PR 0.

# Public origin, used for canonical URLs and the sitemap (PR 10).
SITE_URL=

# Feedback database on Turso (PR 9). Locally a file works too: file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Feedback e-mail delivery through Resend (PR 9).
RESEND_API_KEY=
# Address that receives the feedback messages.
FEEDBACK_TO=

# GA4 measurement ID, e.g. G-XXXXXXXXXX (PR 11). Loaded only after consent.
PUBLIC_GA_ID=
