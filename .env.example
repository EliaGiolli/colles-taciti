# Environment variables for Colles Taciti.
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored:
# real secrets never enter the repository. Production values live in the
# Vercel project settings (changing them needs Elia's confirmation).
#
# The typed schema (astro:env) lives in src/core/config/env.ts. Everything is
# optional for the static build; the feedback form needs the database.

# Feedback database on Turso. Locally a file works too: file:local.db
# Create or update its table with `bun run db:migrate`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Feedback e-mail delivery through Resend. Without these, feedback is saved
# but not e-mailed.
RESEND_API_KEY=
# Address that receives the feedback messages.
FEEDBACK_TO=

# GA4 measurement ID, e.g. G-XXXXXXXXXX. Loaded only after consent; without it
# there is no consent banner and no analytics.
PUBLIC_GA_ID=
